{
  "manifest_version": 3,
  "name": "XRAY \u2014 API Operations Console",
  "version": "0.3.1",
  "key": "",
  "description": "Capture, understand, and bend API traffic: fetch/XHR/WebSocket/GraphQL capture, mock rules, replay, schema-drift detection, JWT decoding, and BYOK AI explanations.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "clipboardWrite",
    "windows",
    "debugger"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/interceptor.js",
        "content/console-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/utils.js",
        "shared/decrypt.js",
        "shared/store.js",
        "shared/worker-client.js",
        "shared/console-helpers.js",
        "panel/console.js",
        "dist/panel-ui.js",
        "content/content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/hud-mount.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "workers/xray-worker.js",
        "dist/hud-ui.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "sql.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "toggle-xray": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Toggle XRAY panel"
    }
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "XRAY"
  },
  "devtools_page": "devtools/devtools.html",
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
