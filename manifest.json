{
  "manifest_version": 3,
  "name": "XRAY — Encrypted API Visualizer",
  "version": "0.2.0",
  "description": "Ultra-fast API interceptor with auto-decryption, console capture, and world-class visualization. Built to outperform Chrome DevTools.",

  "permissions": ["storage", "scripting", "activeTab", "clipboardWrite", "debugger", "windows"],
  "host_permissions": ["<all_urls>"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/interceptor.js",
        "content/console-capture.js",
        "content/decrypt-bridge.js",
        "shared/console-helpers.js",
        "content/console-executor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/utils.js",
        "shared/decrypt.js",
        "shared/store.js",
        "shared/worker-client.js",
        "shared/console-helpers.js",
        "panel/console.js",
        "dist/panel-ui.js",
        "content/content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/hud-mount.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "workers/xray-worker.js",
        "window.html",
        "dist/hud-ui.js",
        "dist/window-ui.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "toggle-xray": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Toggle XRAY panel"
    }
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "XRAY"
  },

  "devtools_page": "devtools/devtools.html",

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
