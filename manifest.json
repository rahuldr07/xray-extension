{
  "manifest_version": 3,
  "name": "XRAY — Encrypted API Visualizer",
  "version": "0.2.0",
  "description": "Ultra-fast API interceptor with auto-decryption, console capture, and world-class visualization. Built to outperform Chrome DevTools.",

  "permissions": ["storage", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/interceptor.js",
        "content/console-capture.js",
        "content/decrypt-bridge.js",
        "content/console-executor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/utils.js",
        "shared/decrypt.js",
        "shared/store.js",
        "shared/worker-client.js",
        "panel/themes.js",
        "panel/virtual-list.js",
        "panel/insights.js",
        "panel/renderer.js",
        "panel/waterfall.js",
        "panel/search.js",
        "panel/shortcuts.js",
        "panel/codemirror.bundle.js",
        "panel/console.js",
        "panel/console-ui.js",
        "panel/floating.js",
        "content/content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["workers/xray-worker.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "toggle-xray": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Toggle XRAY panel"
    }
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toggle XRAY panel"
  },

  "devtools_page": "devtools/devtools.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
