{
  "manifest_version": 3,
  "name": "XRAY — API Visualizer",
  "version": "0.0.1",
  "description": "Auto-intercepts API calls and displays JSON in a visualizer panel.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content/interceptor.js"], "world": "MAIN", "run_at": "document_start" }
  ],
  "action": { "default_title": "Toggle XRAY" }
}
