{
  "name": "xray-extension",
  "version": "0.3.0",
  "description": "A response operations console for API debugging. Captures fetch/XHR/WebSocket/GraphQL traffic, decrypts encrypted responses, and turns live traffic into exports, schemas, mocks, and replays. Chrome and Edge, Manifest V3.",
  "private": true,
  "main": "background.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/*.e2e.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"dist/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=95 --test-coverage-branches=88 --test-coverage-functions=95 \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "package:extension": "npm run check && node scripts/package-extension.mjs",
    "bench:worker": "node scripts/benchmark-worker-core.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahuldr07/xray-extension.git"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "api-debugging",
    "devtools",
    "http-interception",
    "graphql",
    "websocket"
  ],
  "author": "rahuldr07",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rahuldr07/xray-extension/issues"
  },
  "homepage": "https://github.com/rahuldr07/xray-extension#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-virtual": "^3.13.26",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.14"
  }
}
